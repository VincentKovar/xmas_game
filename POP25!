            <input type="text" id="ai-input" placeholder="Enter query..." autocomplete="off">
            <button id="ai-send">✨</button>
        </div>
    </div>

    <script>
        const apiKey = ""; // API Key handled by runtime

        async function geminiQuery(prompt, systemInstruction) {
            const url = `https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash-preview-09-2025:generateContent?key=${apiKey}`;
            const payload = {
                contents: [{ parts: [{ text: prompt }] }],
                systemInstruction: { parts: [{ text: systemInstruction }] }
            };

            for (let i = 0; i < 5; i++) {
                try {
                    const response = await fetch(url, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(payload)
                    });
                    const data = await response.json();
                    return data.candidates?.[0]?.content?.parts?.[0]?.text;
                } catch (e) {
                    await new Promise(r => setTimeout(r, Math.pow(2, i) * 1000));
                }
            }
            return "SIGNAL LOST. TRY AGAIN.";
        }

        async function revealTruth(btn, context) {
            const revealDiv = btn.parentElement.querySelector('.ai-reveal');
            revealDiv.style.display = 'block';
            revealDiv.innerHTML = '<span class="loading-dots">RECOVERING HIDDEN FRAGMENT</span>';
            
            const systemPrompt = "You are a whistleblower who has compromised CMI Holdings. Your job is to take the corporate doublespeak provided by the user and reveal the sinister, dark truth behind it in 1-2 sharp, punchy sentences. Use a paranoid, X-Files tone. Mention Asset ∞· occasionally.";
            const userPrompt = `What is the real truth behind the POP!25 track titled: ${context}?`;

            const result = await geminiQuery(userPrompt, systemPrompt);
            revealDiv.innerText = result;
        }

        const chatInput = document.getElementById('ai-input');
        const chatSend = document.getElementById('ai-send');
        const chatMessages = document.getElementById('ai-messages');

        async function handleChat() {
            const text = chatInput.value.trim();
            if (!text) return;

            const userMsg = document.createElement('div');
            userMsg.className = 'mb-2 text-gray-500';
            userMsg.innerText = `> ${text}`;
            chatMessages.appendChild(userMsg);
            chatInput.value = '';

            const loadingMsg = document.createElement('div');
            loadingMsg.className = 'mb-2 text-blue-400 italic loading-dots';
            loadingMsg.innerText = 'FETCHING DATA';
            chatMessages.appendChild(loadingMsg);
            chatMessages.scrollTop = chatMessages.scrollHeight;

            const systemPrompt = "You are an anonymous whistleblower (Asset ∞·) inside CMI Holdings. You know about Arthur Sterling (CEO), Marcus Thorne (COO), and Elena Vance (CFO). You know they use games for brainwashing, seizure patents, and dream-advertising. Respond in character with cryptic, helpful info about their conspiracy. Keep it brief (2-3 lines).";
            
            const result = await geminiQuery(text, systemPrompt);
            loadingMsg.classList.remove('loading-dots');
            loadingMsg.innerText = result;
            chatMessages.scrollTop = chatMessages.scrollHeight;
        }

        chatSend.onclick = handleChat;
        chatInput.onkeypress = (e) => { if(e.key === 'Enter') handleChat(); };

        // Original glitch effect
        setInterval(() => {
            const redacted = document.querySelectorAll('.redacted');
            redacted.forEach(el => {
                if(Math.random() > 0.95) {
                    el.style.backgroundColor = 'transparent';
                    el.style.color = '#ff007a';
                    setTimeout(() => {
                        el.style.backgroundColor = '#e0e0e5';
                        el.style.color = '#e0e0e5';
                    }, 100);
                }
            });
        }, 1000);
    </script>
