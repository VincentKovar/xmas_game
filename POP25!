        .sparkle-btn:hover {
            background: var(--cmi-blue);
            color: black;
        }
        .ai-reveal {
            background: rgba(0, 229, 255, 0.05);
            border-left: 2px solid var(--cmi-blue);
            padding: 8px;
            margin-top: 10px;
            font-style: italic;
            font-size: 0.85rem;
            color: #aff;
            display: none;
        }
        #ai-chat-bubble {
            position: fixed;
            bottom: 20px;
            right: 20px;
            width: 350px;
            background: #111;
            border: 1px solid #333;
            border-radius: 12px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.5);
            display: flex;
            flex-direction: column;
            z-index: 1000;
            font-family: 'JetBrains Mono', monospace;
        }
        #ai-messages {
            height: 200px;
            overflow-y: auto;
            padding: 10px;
            font-size: 0.75rem;
            border-bottom: 1px solid #222;
        }
        #ai-input-container {
            display: flex;
            padding: 8px;
        }
        #ai-input {
            flex-grow: 1;
            background: #000;
            border: 1px solid #444;
            color: #fff;
            padding: 4px 8px;
            font-size: 0.8rem;
            border-radius: 4px;
            outline: none;
        }
        #ai-send {
            margin-left: 8px;
            color: var(--cmi-blue);
            cursor: pointer;
        }
        .loading-dots:after {
            content: '.';
            animation: dots 1s steps(5, end) infinite;
        }
        @keyframes dots {
            0%, 20% { content: '.'; }
            40% { content: '..'; }
            60% { content: '...'; }
            80%, 100% { content: ''; }
        }
    </style>
</head>
