            position: relative;
        }

        .track-card:hover {
            border-color: var(--cmi-blue);
            transform: translateY(-5px);
        }

        .watermark {
            position: fixed;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%) rotate(-30deg);
